{
    "name": "haunt/settings",
    "description": "Sitewide settings for an application.",
    "version": "dev-main",
    "authors": [
        {
            "name": "crotanite",
            "email": "crotanite@lumitestudios.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "haunt/framework": "dev-main"
    },
    "require-dev": {
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Haunt\\Settings\\": "src/"
        }
    },
    "extra": {
        "haunt": {
            "name": "Haunt: Settings",
            "plugin": "\\Haunt\\Settings\\SettingsPlugin"
        }
    },
    "scripts": {
        "pint": [
            "pint"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
